{
  "name": "Resend Domain Registration",
  "description": "When a company verifies their email domain, automatically register it with Resend to prevent spam issues",
  "trigger": {
    "condition": "${ ((.trigger.data.mail_domain_verified == true) and (.trigger.data.mail_domain != null and .trigger.data.mail_domain != \"\" and .trigger.data.mail_domain != [] and .trigger.data.mail_domain != {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "CompanyEmailSettings"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "resend_domain_registration",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "registerResendDomain",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}