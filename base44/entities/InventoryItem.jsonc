{
  "name": "InventoryItem",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "internal",
        "customer",
        "digital"
      ],
      "default": "internal"
    },
    "category": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "quantity_min": {
      "type": "number",
      "default": 1,
      "description": "Low stock alert threshold"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "in_use",
        "maintenance",
        "retired"
      ],
      "default": "available"
    },
    "assigned_to": {
      "type": "string"
    },
    "unit_cost": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.company_id}}"
    },
    "read": {
      "data.company_id": "{{user.company_id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        }
      ],
      "data.company_id": "{{user.company_id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        }
      ],
      "data.company_id": "{{user.company_id}}"
    }
  }
}