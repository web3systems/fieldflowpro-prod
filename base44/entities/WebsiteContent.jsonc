{
  "name": "WebsiteContent",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "section": {
      "type": "string",
      "enum": [
        "hero",
        "about",
        "service",
        "pricing",
        "faq",
        "testimonial",
        "gallery",
        "cta"
      ],
      "description": "Which section of the website this content belongs to"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "button_text": {
      "type": "string"
    },
    "button_url": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "price_note": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "company_id",
    "section",
    "title"
  ]
}