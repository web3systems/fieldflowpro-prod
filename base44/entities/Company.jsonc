{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "parent_company_id": {
      "type": "string",
      "description": "If set, this is a sub-company (location) of the parent company"
    },
    "industry": {
      "type": "string",
      "enum": [
        "cleaning",
        "landscaping",
        "handyman",
        "painting",
        "plumbing",
        "electrical",
        "hvac",
        "other"
      ]
    },
    "logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "default_tax_rate": {
      "type": "number",
      "default": 0
    },
    "google_review_url": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "portal_settings": {
      "type": "object",
      "description": "Customer portal configuration",
      "properties": {
        "auto_send_invite": {
          "type": "boolean",
          "default": true
        },
        "include_portal_link": {
          "type": "boolean",
          "default": true
        },
        "referral_enabled": {
          "type": "boolean",
          "default": true
        },
        "referral_message": {
          "type": "string"
        }
      }
    },
    "seo_settings": {
      "type": "object",
      "description": "SEO and analytics configuration",
      "properties": {
        "google_analytics_id": {
          "type": "string",
          "description": "Google Analytics 4 Measurement ID (G-XXXXXXXXXX)"
        },
        "google_tag_manager_id": {
          "type": "string",
          "description": "Google Tag Manager container ID (GTM-XXXXXXX)"
        },
        "google_search_console_verification": {
          "type": "string",
          "description": "Google Search Console meta verification code"
        },
        "meta_title": {
          "type": "string",
          "description": "Custom page title for SEO"
        },
        "meta_description": {
          "type": "string",
          "description": "Meta description for search engines (150-160 chars)"
        },
        "meta_keywords": {
          "type": "string",
          "description": "Comma-separated keywords"
        },
        "og_title": {
          "type": "string",
          "description": "Open Graph title for social sharing"
        },
        "og_description": {
          "type": "string",
          "description": "Open Graph description for social sharing"
        },
        "og_image_url": {
          "type": "string",
          "description": "Open Graph image URL for social sharing"
        },
        "canonical_url": {
          "type": "string",
          "description": "Canonical URL for the business website"
        },
        "schema_type": {
          "type": "string",
          "enum": [
            "LocalBusiness",
            "HomeAndConstructionBusiness",
            "LandscapingService",
            "HVACBusiness",
            "Plumber",
            "Electrician",
            "CleaningService",
            "GeneralContractor"
          ],
          "default": "LocalBusiness",
          "description": "JSON-LD schema type for rich search results"
        },
        "schema_enabled": {
          "type": "boolean",
          "default": true
        },
        "facebook_pixel_id": {
          "type": "string",
          "description": "Facebook/Meta Pixel ID for ad tracking"
        },
        "bing_uet_id": {
          "type": "string",
          "description": "Bing UET tag ID"
        }
      }
    },
    "stripe_account_id": {
      "type": "string"
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ]
}