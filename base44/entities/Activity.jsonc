        "job",
        "lead",
        "invoice",
        "estimate"
      ]
    },
    "related_to_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
