{
  "name": "Module",
  "type": "object",
  "properties": {
    "module_key": {
      "type": "string",
      "description": "Unique identifier key used to gate features (e.g. ai_estimator, accounting)"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of feature bullets shown in marketplace"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "price_monthly": {
      "type": "number"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "stripe_product_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "ai",
        "operations",
        "finance",
        "marketing",
        "growth"
      ],
      "default": "operations"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "module_key",
    "name",
    "price_monthly"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "service_role"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "service_role"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_role"
      }
    }
  }
}