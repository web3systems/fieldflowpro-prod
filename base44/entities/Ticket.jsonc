{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "waiting_customer",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "category": {
      "type": "string",
      "enum": [
        "billing",
        "technical",
        "feature_request",
        "account",
        "other"
      ],
      "default": "other"
    },
    "submitter_email": {
      "type": "string"
    },
    "submitter_name": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "ai_suggested_response": {
      "type": "string"
    },
    "ai_category_suggestion": {
      "type": "string"
    },
    "ai_priority_suggestion": {
      "type": "string"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sender_email": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "is_from_support": {
            "type": "boolean"
          }
        }
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "portal",
        "email"
      ],
      "default": "portal"
    },
    "email_thread_id": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "subject",
    "description",
    "submitter_email"
  ]
}