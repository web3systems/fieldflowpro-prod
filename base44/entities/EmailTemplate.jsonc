{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "template_type": {
      "type": "string",
      "enum": [
        "estimate",
        "invoice",
        "job_scheduled",
        "job_completed",
        "estimate_approved",
        "estimate_declined",
        "payment_received",
        "appointment_reminder",
        "follow_up",
        "custom"
      ],
      "description": "Type of template"
    },
    "name": {
      "type": "string",
      "description": "Display name for this template"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line (supports {{variables}})"
    },
    "body_html": {
      "type": "string",
      "description": "Full HTML body of the email"
    },
    "body_text": {
      "type": "string",
      "description": "Plain text fallback body"
    },
    "header_color": {
      "type": "string",
      "default": "#3B82F6",
      "description": "Primary header color (hex)"
    },
    "accent_color": {
      "type": "string",
      "default": "#1E293B",
      "description": "Accent color for text and borders"
    },
    "logo_url": {
      "type": "string",
      "description": "Company logo URL"
    },
    "company_name": {
      "type": "string",
      "description": "Company name to display"
    },
    "company_phone": {
      "type": "string"
    },
    "company_email": {
      "type": "string"
    },
    "footer_text": {
      "type": "string",
      "description": "Custom footer text"
    },
    "show_logo": {
      "type": "boolean",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "If true this is the system default template (seeded)"
    }
  },
  "required": [
    "company_id",
    "template_type",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      },
      "data.company_id": "{{user.company_id}}"
    },
    "read": {
      "data.company_id": "{{user.company_id}}"
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      },
      "data.company_id": "{{user.company_id}}"
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      },
      "data.company_id": "{{user.company_id}}"
    }
  }
}