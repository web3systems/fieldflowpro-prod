{
  "name": "Notification",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_job_assigned",
        "job_status_change",
        "job_reminder",
        "new_booking",
        "new_lead",
        "new_customer",
        "invoice_paid",
        "invoice_overdue",
        "payment_received",
        "estimate_approved",
        "system"
      ]
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "link_to": {
      "type": "string"
    },
    "related_entity_type": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    },
    "channels_sent": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "company_id",
    "user_email",
    "title",
    "type"
  ]
}