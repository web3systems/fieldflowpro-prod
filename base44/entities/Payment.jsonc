{
  "name": "Payment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "check",
        "card",
        "stripe",
        "venmo",
        "zelle",
        "bank_transfer",
        "other"
      ],
      "default": "cash"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "deposit",
        "partial",
        "final"
      ],
      "default": "final"
    },
    "received_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "recorded_by": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe checkout session ID for deduplication"
    }
  },
  "required": [
    "company_id",
    "amount",
    "received_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "service_role"
          }
        }
      ]
    },
    "read": {
      "data.company_id": "{{user.company_id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}