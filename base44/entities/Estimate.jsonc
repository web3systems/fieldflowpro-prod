{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "estimate_number": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "approved",
        "declined",
        "expired"
      ],
      "default": "draft"
    },
    "options": {
      "type": "array",
      "description": "Multiple estimate options the customer can choose from",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unit_price": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              }
            }
          },
          "subtotal": {
            "type": "number",
            "default": 0
          },
          "tax_rate": {
            "type": "number",
            "default": 0
          },
          "tax_amount": {
            "type": "number",
            "default": 0
          },
          "discount": {
            "type": "number",
            "default": 0
          },
          "total": {
            "type": "number",
            "default": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "valid_until": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "customer_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.company_id}}"
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}"
        },
        {
          "user_condition": {
            "role": "customer"
          },
          "data.customer_id": "{{user.customer_id}}",
          "data.status": {
            "$ne": "draft"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          },
          "data.company_id": "{{user.company_id}}"
        },
        {
          "created_by_id": "{{user.id}}",
          "data.company_id": "{{user.company_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        }
      ],
      "data.company_id": "{{user.company_id}}"
    }
  }
}