{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "estimate_number": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "approved",
        "declined",
        "expired",
        "closed"
      ],
      "default": "draft"
    },
    "manager_approved": {
      "type": "boolean",
      "default": false,
      "description": "Required for Honey-Do Crew: must be approved by Tim Parrow before PDF/email is allowed"
    },
    "scope_of_work": {
      "type": "string",
      "description": "Rich-text scope of work / statement of work. Renders as a separate section in the PDF."
    },
    "options": {
      "type": "array",
      "description": "Multiple estimate options the customer can choose from",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unit_price": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              }
            }
          },
          "subtotal": {
            "type": "number",
            "default": 0
          },
          "tax_rate": {
            "type": "number",
            "default": 0
          },
          "tax_amount": {
            "type": "number",
            "default": 0
          },
          "discount": {
            "type": "number",
            "default": 0
          },
          "total": {
            "type": "number",
            "default": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "valid_until": {
      "type": "string"
    },
    "job_id": {
      "type": "string",
      "description": "ID of the Job created when this estimate was approved. Once set, the estimate is 'closed' and no longer tracks the job's lifecycle."
    }
  },
  "required": [
    "company_id",
    "customer_id",
    "title"
  ]
}