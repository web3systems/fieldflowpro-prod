{
  "name": "Technician",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "on_leave"
      ],
      "default": "active"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "color": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "first_name",
    "last_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      },
      "data.company_id": "{{user.company_id}}"
    },
    "read": {
      "data.company_id": "{{user.company_id}}"
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      },
      "data.company_id": "{{user.company_id}}"
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      },
      "data.company_id": "{{user.company_id}}"
    }
  }
}