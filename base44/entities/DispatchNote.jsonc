{
  "name": "DispatchNote",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "technician_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "dispatched_by": {
      "type": "string"
    },
    "dispatched_at": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "assignment",
        "reassignment",
        "instruction",
        "update"
      ],
      "default": "assignment"
    },
    "sms_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "company_id",
    "job_id"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.company_id}}"
    },
    "read": {
      "data.company_id": "{{user.company_id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}