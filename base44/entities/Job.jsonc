{
  "name": "Job",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "estimate_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "job_number": {
      "type": "string",
      "description": "Auto-incrementing job number per company (format: JOB-0001)"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "estimated",
        "scheduled",
        "in_progress",
        "invoiced",
        "completed",
        "cancelled",
        "on_hold",
        "archived"
      ],
      "default": "new"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "scheduled_start": {
      "type": "string"
    },
    "scheduled_end": {
      "type": "string"
    },
    "actual_start": {
      "type": "string"
    },
    "actual_end": {
      "type": "string"
    },
    "appointments": {
      "type": "array",
      "description": "Multiple scheduled visits for this job. Each has its own start/end, status, notes, and optional tech override.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "scheduled_start": {
            "type": "string"
          },
          "scheduled_end": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "upcoming",
              "in_progress",
              "completed",
              "cancelled"
            ],
            "default": "upcoming"
          },
          "notes": {
            "type": "string"
          },
          "assigned_techs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assigned_techs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "internal_notes_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "created_by": {
            "type": "string"
          }
        }
      }
    },
    "customer_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "created_by": {
            "type": "string"
          }
        }
      }
    },
    "scope_of_work": {
      "type": "string",
      "description": "Original statement of work carried over from the approved estimate. Rich-text HTML."
    },
    "scope_of_work_revisions": {
      "type": "array",
      "description": "Additional statements of work added after job creation (e.g. change orders, project additions). Each can be sent for e-signature.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "description": "Rich-text HTML content of the revision"
          },
          "created_at": {
            "type": "string"
          },
          "created_by": {
            "type": "string"
          },
          "created_by_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "pending",
              "signed",
              "declined"
            ],
            "default": "draft"
          },
          "sent_at": {
            "type": "string"
          },
          "sent_to_email": {
            "type": "string"
          },
          "signed_by_name": {
            "type": "string"
          },
          "signed_at": {
            "type": "string"
          },
          "signature_ip": {
            "type": "string"
          }
        }
      }
    },
    "line_items": {
      "type": "array",
      "description": "Line items transferred from the estimate (labor & materials)",
      "items": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "before_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos taken before the job begins"
    },
    "after_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos taken after the job is completed"
    },
    "receipts": {
      "type": "array",
      "description": "Receipt photos with OCR-extracted data",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string"
          },
          "uploaded_by": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "total": {
            "type": "number"
          },
          "category": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                }
              }
            }
          },
          "notes": {
            "type": "string"
          },
          "ocr_processed": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          }
        }
      }
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence_interval": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly",
        "quarterly"
      ]
    },
    "recurrence_parent_id": {
      "type": "string"
    },
    "deposit_amount": {
      "type": "number",
      "description": "Deposit amount requested"
    },
    "deposit_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "waived"
      ],
      "description": "Current status of the deposit"
    },
    "deposit_paid_date": {
      "type": "string",
      "description": "Date the deposit was paid"
    },
    "deposit_stripe_link": {
      "type": "string",
      "description": "Stripe payment link URL for the deposit"
    },
    "deposit_payment_intent_id": {
      "type": "string",
      "description": "Stripe payment intent ID once paid"
    },
    "deposit_invoice_id": {
      "type": "string",
      "description": "Invoice ID created for the deposit"
    }
  },
  "required": [
    "company_id",
    "customer_id",
    "title"
  ]
}